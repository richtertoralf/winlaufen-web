# Gemeinsame Kenngrößen von WinLaufen Web.
#
# Diese Werte stammen aus dem Anwendungscode und dürfen hier nicht abweichend
# erfunden werden. Sie werden von den Installern für Linux und Windows sowie von
# den Installer-Tests eingelesen.
#
# Quellen im Code:
#   pom.xml                                          -> WINLAUFEN_JAVA_RELEASE
#   bridge/pom.xml, live-server/pom.xml               -> Artefaktnamen, Hauptklassen
#   BridgeConfigStore.DEFAULT_*                       -> Bridge-Control-Port, lokale Ports
#   LiveServerConfig.system()                         -> Live-Server-Systemproperties
#   LiveWebSocketServer.ingestPath / BROWSER_PATH     -> WebSocket-Pfade
#   BridgeConfig.WINLAUFEN_PORT                       -> fester WinLaufen-Port

WINLAUFEN_PRODUCT_NAME="WinLaufen Web"
WINLAUFEN_JAVA_RELEASE=25

WINLAUFEN_BRIDGE_JAR="winlaufen-web-bridge.jar"
WINLAUFEN_BRIDGE_MAIN="de.winlaufen.web.bridge.BridgeMain"
WINLAUFEN_LIVE_JAR="winlaufen-web-live-server.jar"
WINLAUFEN_LIVE_MAIN="de.winlaufen.web.liveserver.LiveServerMain"

# WinLaufen-Quelle: Port ist im Protokoll fest, nur der Host ist konfigurierbar.
WINLAUFEN_SOURCE_PORT=4444
WINLAUFEN_DEFAULT_SOURCE_HOST="127.0.0.1"

# Bridge Control: im vertrauenswürdigen LAN erreichbar.
WINLAUFEN_CONTROL_BIND="0.0.0.0"
WINLAUFEN_CONTROL_PORT=44442

# Live Server.
WINLAUFEN_LIVE_HTTP_BIND="0.0.0.0"
WINLAUFEN_LIVE_HTTP_PORT=44440
WINLAUFEN_LIVE_WS_BIND="0.0.0.0"
WINLAUFEN_LIVE_WS_PORT=44441
WINLAUFEN_LIVE_CHANNEL="local"

# WebSocket-Pfade des Live Servers.
WINLAUFEN_INGEST_PATH_PREFIX="/bridge/v1/channels/"
WINLAUFEN_BROWSER_PATH="/live/v1"

# Bekanntes Prototyp-Ingest-Secret. Siehe README.md, Abschnitt
# "Known prototype security limitation". Der Installer erzeugt bewusst kein
# eigenes Secret, damit Bridge und Presentation Node auf getrennten Rechnern
# ohne zusätzlichen Abgleich zusammenarbeiten.
WINLAUFEN_DEFAULT_SECRET="local-development-secret"

# Systemproperty, mit der die Bridge ihre Konfigurationsdatei findet.
WINLAUFEN_BRIDGE_CONFIG_PROPERTY="winlaufen.bridge.config"
